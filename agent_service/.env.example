# Agent Service - variables de entorno (copiar a .env y rellenar, nunca commitear .env real)

AGENT_SERVICE_PORT=8003

# Qdrant - BD vectorial para RAG (conocimiento/contexto del agente)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=tdah_agent_memory

# MongoDB - lectura de activity_logs (misma BD que tools_service) para
# analisis de patrones y sugerencias proactivas (Objetivo 4 del PDF)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=tdah_routines

# Proveedor de LLM: Gemini (coherente con las integraciones de Google
# Calendar/Tasks/Maps/Gmail ya usadas por tools_service)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Tools service - el agente invoca tools a traves de este microservicio
TOOLS_SERVICE_URL=http://localhost:8002

# Debe coincidir con el de auth_service/gateway - decodifica el JWT de sesion
# para saber que usuario esta conversando con el agente.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Parametros de memoria a corto plazo (Cap. 2.2.2, Objetivo 2 del PDF de tesina)
SHORT_TERM_MEMORY_WINDOW=10
RAG_TOP_K=5
LLM_TEMPERATURE=0.3
