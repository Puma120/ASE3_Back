# Tools Service - variables de entorno (copiar a .env y rellenar, nunca commitear .env real)

TOOLS_SERVICE_PORT=8002

# PostgreSQL - lectura de datos relacionales de usuario cuando una tool lo requiera
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tdah_auth

# MongoDB - rutinas y registros (historial de tareas, logs de interacciones)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=tdah_routines

# Debe coincidir con el de auth_service/gateway - decodifica el JWT de sesion
# para saber que usuario esta invocando cada tool.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Credenciales OAuth para llamar APIs de Google en nombre del usuario
# (Calendar, Tasks, Maps, Gmail) - el flujo de consentimiento se maneja en
# auth_service/frontend, aqui solo se usan los tokens ya obtenidos.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
