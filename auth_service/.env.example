# Auth Service - variables de entorno (copiar a .env y rellenar, nunca commitear .env real)

AUTH_SERVICE_PORT=8001

# PostgreSQL - usuarios / metadata (ver Capa de Persistencia, project_map.md)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tdah_auth

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OAuth (login con Google + consentimiento Calendar/Tasks/Gmail en el mismo paso)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Debe coincidir EXACTO con un "Authorized redirect URI" del OAuth Client en
# Google Cloud Console (ver deploy_railway_vercel.md 3.1). Pasa por el gateway.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# A donde redirige /auth/google/callback tras un login web exitoso (le agrega #token=...)
PWA_BASE_URL=http://localhost:5173
# Scheme del deep link para el redirect en movil (debe calzar con app.json "scheme")
GOOGLE_OAUTH_MOBILE_SCHEME=ase3agentetdah
