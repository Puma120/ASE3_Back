# Gateway - variables de entorno (copiar a .env y rellenar, nunca commitear .env real)

GATEWAY_PORT=8000

# URLs internas de los microservicios (red docker/local)
AUTH_SERVICE_URL=http://localhost:8001
TOOLS_SERVICE_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8003

# Debe coincidir con el secreto usado por auth_service para firmar los JWT,
# para que el gateway pueda validar sesiones sin llamar a auth_service en cada request.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Servicio proactivo (recordatorios y avisos de tareas)
PROACTIVE_SERVICE_URL=http://localhost:8004

# Origenes web permitidos por CORS, separados por coma (la app nativa no usa CORS)
CORS_ORIGINS=https://ase3-front-pwa.vercel.app,http://localhost:8081,http://localhost:19006,http://localhost:5173
